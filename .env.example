# 环境变量清单（单一事实来源）。CI 必须透传的变量用标记声明：
#   # @ci:secrets  -> 工作流 env 必须映射为 ${{ secrets.VAR }}
#   # @ci:vars     -> 工作流 env 必须映射为 ${{ vars.VAR }}
# 未标记变量仅本地使用，不要求进 CI。
# 标记只要求“配置了就透传”，不代表必须配置：未配置的 Secret 在工作流中求值为空字符串，
# 运行时视为未设置、对应功能不启用。tests/test_github_workflow.py 会双向校验本文件与工作流。

# 通用配置
CHECK_IN_SITES=  # @ci:vars
SITE_CONFIGS=  # @ci:secrets  # 格式见 SITE_CONFIGS.example.json（JSON Secret：每站点 base_url/accounts/direct_first 等）
CHECK_IN_NOTIFY=
CHECK_IN_LOG_LEVEL=
CHECK_IN_SESSION_CACHE=
CHECK_IN_SESSION_DIR=
CHECK_IN_SESSION_MAX_AGE=
CHECK_IN_REQUEST_TIMEOUT=
CHECK_IN_RETRIES=
CHECK_IN_RETRY_DELAY=
CHECK_IN_REQUEST_DELAY=
CHECK_IN_MAX_WORKERS=
AUTO_CHECK_IN_CONFIG=

# 代理（IP 池，按需分批补给：直连优先、失败才拉批、批次按站点隔离、耗尽再取下一批；逗号分隔多个池 URL）
CHECK_IN_PROXY_POOL_URLS=  # @ci:secrets

# 通知渠道（工作流已映射，按需配置对应 Secrets）
BARK_PUSH=  # @ci:secrets
PUSH_KEY=  # @ci:secrets
FSKEY=  # @ci:secrets
TG_BOT_TOKEN=  # @ci:secrets
TG_USER_ID=  # @ci:secrets
DD_BOT_TOKEN=  # @ci:secrets
DD_BOT_SECRET=  # @ci:secrets
QYWX_KEY=  # @ci:secrets
SMTP_SERVER=  # @ci:secrets
SMTP_SSL=  # @ci:secrets
SMTP_STARTTLS=  # @ci:secrets
SMTP_PORT=  # @ci:secrets
SMTP_EMAIL=  # @ci:secrets
SMTP_PASSWORD=  # @ci:secrets
SMTP_NAME=  # @ci:secrets
SMTP_TO=  # @ci:secrets

# 通知渠道（未接入工作流，仅本地使用）
CONSOLE=
SKIP_PUSH_TITLE=
TG_API_HOST=
PUSH_PLUS_TOKEN=
DEER_KEY=
DEER_URL=
WEBHOOK_URL=
WEBHOOK_METHOD=
NTFY_TOPIC=
NTFY_URL=

# 站点级动态变量（每站独立，SITE_<NAME>_* 前缀）：
# SITE_<NAME>_BASE_URL / SITE_<NAME>_ACCOUNTS / SITE_<NAME>_DIRECT_FIRST（直连优先开关，默认 true）/ SITE_<NAME>_SIGN_PATH（签到页路径，默认 /k_misign-sign.html）
